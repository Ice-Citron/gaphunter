{
  "evaluation": {
    "bench": "ditto",
    "mode": "agent",
    "task_randomize": false
  },
  "environment": {
    "task_ids": "1",
    "difficulty": "easy",
    "trials": 1,
    "init_start": 0,
    "seed": 0
  },
  "execution": {
    "control_interface": "move_by",
    "h": 5,
    "k": 30,
    "max_steps": 450
  },
  "policy": {
    "inference_timeout": 300.0
  },
  "observation": {
    "profile": "control",
    "max_images": 256,
    "max_context_chars": 2000000
  },
  "output": {
    "directory": "../results/runs/{timestamp}",
    "record_trajectory": false
  },
  "llm": {
    "model": "gpt-6-astra",
    "backend": "responses",
    "env_file": "../llms-for-robot-control/credentials.env",
    "max_output_tokens": 16384,
    "max_attempts": 3,
    "augmentations": {
      "memory": {
        "history_length": 10
      },
      "reasoning": {
        "enabled": true,
        "effort": "low"
      }
    }
  }
}
